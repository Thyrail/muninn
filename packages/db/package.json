{
  "name": "@muninn/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm build && node --env-file-if-exists=../../.env dist/seed.js",
    "db:migrate:new": "node scripts/new-migration.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "^1.7.14",
    "dotenv": "^18.0.9",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
