# Muninn environment. Copy to `.env` (repo root for local dev, ~/docker/muninn/.env on the server).
# Never commit real values.

# --- General -------------------------------------------------------------
NODE_ENV=development
# Public host name (no scheme). Used for Traefik routing and Better Auth trusted origins.
DOMAIN=localhost:3000
LOG_LEVEL=info

# --- Web (Next.js) -------------------------------------------------------
# Where the web server reaches the API (dev rewrites + server components).
# Set by the prod compose to http://muninn-api:4000.
API_INTERNAL_URL=http://localhost:4000
# Shows the demo account (DEMO_USER_EMAIL / DEMO_USER_PASSWORD) with a one-click login.
SHOW_DEMO_LOGIN=true

# --- Database / Redis ----------------------------------------------------
# Local dev: localhost. Prod compose: postgresql://muninn:<POSTGRES_PASSWORD>@muninn-postgres:5432/muninn
DATABASE_URL=postgresql://muninn:muninn@localhost:5432/muninn
# Prod compose: redis://muninn-redis:6379
REDIS_URL=redis://localhost:6379
# Prod compose only: credentials for the bundled Postgres container.
POSTGRES_USER=muninn
POSTGRES_PASSWORD=change-me
POSTGRES_DB=muninn

# --- Object storage (S3 compatible, SeaweedFS locally) -----------------------
# Prod compose: http://muninn-s3:8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=muninn
S3_ACCESS_KEY_ID=muninn
S3_SECRET_ACCESS_KEY=muninn-secret
S3_FORCE_PATH_STYLE=true

# --- Auth (Better Auth) --------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public base URL of the app (same origin as the API).
BETTER_AUTH_URL=http://localhost:3000
ALLOW_SIGNUP=true
DEMO_USER_EMAIL=demo@muninn.app
DEMO_USER_PASSWORD=change-me-demo

# --- LLM providers -------------------------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Model IDs are configuration, never hardcoded. Check provider docs for current IDs.
CHAT_MODEL=
EMBEDDING_MODEL=
# Must match the vector(N) column in the database migration.
EMBEDDING_DIM=768
TTS_MODEL=
TTS_VOICE_HUGIN=
TTS_VOICE_MUNIN=
# Emergency brake: max LLM requests per day across all users.
DAILY_LLM_REQUEST_CAP=2000

# --- Deployment (prod compose) -------------------------------------------
IMAGE_TAG=latest
IMAGE_OWNER=thyrail
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=myresolver
