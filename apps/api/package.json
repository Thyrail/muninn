{
  "name": "@muninn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --env-file ../../.env",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:worker": "sh -c 'until [ -f dist/worker.js ]; do sleep 1; done; exec node --watch --env-file=../../.env dist/worker.js'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.91",
    "@ai-sdk/google": "^4.0.107",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@mozilla/readability": "^0.6.0",
    "@muninn/db": "workspace:*",
    "@muninn/shared": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "ai": "^7.0.155",
    "better-auth": "^1.7.14",
    "bullmq": "^6.5.0",
    "ioredis": "^5.11.1",
    "linkedom": "^0.18.14",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^8.12.3",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
